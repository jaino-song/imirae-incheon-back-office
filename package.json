{
  "name": "babyjamjam-admin-workspace",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev:fe": "pnpm --filter ./frontend dev",
    "dev:be": "pnpm --filter ./backend start:dev",
    "dev:mobile": "pnpm --filter ./mobile dev",
    "build:fe": "pnpm --filter ./frontend build",
    "build:be": "pnpm --filter ./backend build",
    "build:mobile": "pnpm --filter ./mobile build",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "lint": "pnpm -r --workspace-concurrency=1 --if-present run lint",
    "lint:ui-architecture": "node packages/shared/scripts/ui-architecture-gate.mjs",
    "lint:e2e-strings": "node packages/shared/scripts/e2e-string-drift-gate.mjs"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "1.1.18",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "postcss@<8.5.23": "8.5.23",
      "ip-address@>=10.0.0 <10.3.1": "10.3.1",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "undici@>=6.0.0 <6.28.0": "6.28.0",
      "hono@>=4.0.0 <4.12.34": "4.12.34",
      "passport-oauth2@<1.6.1": "1.6.1",
      "effect@<3.20.0": "3.20.0",
      "deepmerge-ts@<8.0.1": "8.0.1",
      "sharp@<0.35.0": "0.35.0",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "nanoid@>=4.0.0 <5.1.16": "5.1.16"
    },
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "@nestjs/core",
      "@parcel/watcher",
      "@sentry/cli",
      "@swc/core",
      "sharp",
      "unrs-resolver"
    ]
  }
}
