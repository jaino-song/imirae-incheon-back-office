# Backend database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/babyjamjam_auth_e2e
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55432/babyjamjam_auth_e2e

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
AUTH_EMAIL_TOKEN_HMAC_SECRET=replace-with-a-distinct-random-secret

# Valkey primary rate-limit store
VALKEY_URL=redis://127.0.0.1:56379

# Email: use "resend" outside isolated E2E, "smtp" for Mailpit
EMAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=51025
SMTP_SECURE=false
SMTP_FROM_EMAIL=admin@babyjamjam.local
RESEND_API_KEY=
RESEND_FROM_EMAIL=admin@babyjamjam.com

# Notification channels: master switches, both off unless explicitly "true"
NOTIFICATION_EMAIL_ENABLED=false
PWA_NOTIFICATIONS_ENABLED=false
# Web push (VAPID) — generate a keypair once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@babyjamjam.com

# Local app URLs
DEVELOPMENT_FRONTEND_URL=http://127.0.0.1:3000
DEVELOPMENT_MOBILE_FRONTEND_URL=http://127.0.0.1:3002
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000

# Release A read-only operational copilot (production defaults are disabled).
# Emergency rollback: set AGENT_ENABLED=false and AGENT_READ_ENABLED=false,
# then disable NEXT_PUBLIC_AGENT_SHELL_ENABLED in the frontend environment.
# AGENT_RETENTION_DAYS is configurable; privacy review must approve production values.
AGENT_ENABLED=false
# off | development | internal | branch-read | branch-write
AGENT_ROLLOUT_STAGE=off
AGENT_VERSION=operational-copilot-development
# Mounted result from the manual real-runtime evaluation workflow.
AGENT_EVAL_ARTIFACT_PATH=
# Commit SHA that evaluation evidence must be cryptographically bound to.
AGENT_RELEASE_COMMIT_SHA=
# D13 only: protected external JSON manifest, created after the candidate SHA
# exists, containing commit-bound evidence and signoffs.
AGENT_CUTOVER_MANIFEST_JSON=
AGENT_RELEASE_CANDIDATE_SHA=
AGENT_READ_ENABLED=false
AGENT_WRITE_ENABLED=false
AGENT_EXTERNAL_ENABLED=false
AGENT_PRIVILEGED_ENABLED=false
AGENT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
AGENT_RATE_LIMIT_PER_MINUTE=20
AGENT_RETENTION_DAYS=30
AGENT_BRANCH_ALLOWLIST=
AGENT_USER_ALLOWLIST=
AGENT_ROUTER_CLASSIFIER_ENABLED=true
E2E_VENDOR_STUBS=0
