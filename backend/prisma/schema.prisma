generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model area {
  id              String             @id
  name            String
  koreanName      String             @map("korean_name")
  branchId        String?            @map("branch_id") @db.Uuid
  branch          branch?            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bankAccountInfo bank_account_info?
  clients         client[]
  docTemplates    doc_template[]

  @@index([branchId], map: "idx_area_branch")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model bank_account_info {
  areaId   String  @id(map: "bankAccountInfo_pkey") @map("area_id")
  bankName String? @map("bank_name")
  accNum   String? @map("acc_num")
  area     area    @relation(fields: [areaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chat_feedback {
  id          String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId   String       @map("session_id")
  messageId   String       @map("message_id")
  userId      String       @map("user_id") @db.Uuid
  type        String
  comment     String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  chatMessage chat_message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chatSession chat_session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        user         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([sessionId])
  @@index([type])
  @@index([userId])
}

model chat_message {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId    String          @map("session_id")
  role         String
  content      String
  timestamp    DateTime        @default(now()) @db.Timestamptz(6)
  chatFeedback chat_feedback[]
  chatSession  chat_session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([timestamp])
}

model chat_session {
  id           String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId       String          @map("user_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  chatFeedback chat_feedback[]
  messages     chat_message[]
  user         user            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([expiresAt])
  @@index([userId])
}

model agent_session {
  id               String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId           String           @map("user_id") @db.Uuid
  branchId         String           @map("branch_id") @db.Uuid
  locale           String           @default("ko") @db.VarChar(10)
  title            String?
  summary          String?
  selectedEntities Json             @default("{}") @map("selected_entities")
  model            String
  agentVersion     String           @map("agent_version")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  archivedAt       DateTime?        @map("archived_at") @db.Timestamptz(6)
  user             user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch           branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  messages         agent_message[]
  actions          agent_action[]
  traces           agent_trace[]
  feedback         agent_feedback[]

  @@index([branchId, userId, updatedAt], map: "idx_agent_session_owner_updated")
  @@index([expiresAt], map: "idx_agent_session_expires_at")
  @@index([archivedAt], map: "idx_agent_session_archived_at")
}

model agent_message {
  id        String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId String           @map("session_id")
  role      String           @db.VarChar(20)
  parts     Json
  traceId   String?          @map("trace_id")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  session   agent_session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trace     agent_trace?     @relation(fields: [traceId], references: [id], onDelete: SetNull)
  feedback  agent_feedback[]

  @@index([sessionId, createdAt], map: "idx_agent_message_session_created")
  @@index([traceId], map: "idx_agent_message_trace")
}

model agent_action {
  id                   String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId            String        @map("session_id")
  userId               String        @map("user_id") @db.Uuid
  branchId             String        @map("branch_id") @db.Uuid
  capability           String
  capabilityVersion    String        @map("capability_version")
  risk                 String        @db.VarChar(40)
  status               String        @default("proposed") @db.VarChar(20)
  proposal             Json
  proposalRevision     String        @map("proposal_revision")
  inputHash            String        @map("input_hash")
  targetSnapshot       Json?         @map("target_snapshot")
  targetVersion        String?       @map("target_version")
  authorizationContext Json          @map("authorization_context")
  approvedBy           String?       @map("approved_by") @db.Uuid
  approvedAt           DateTime?     @map("approved_at") @db.Timestamptz(6)
  rejectedBy           String?       @map("rejected_by") @db.Uuid
  rejectedAt           DateTime?     @map("rejected_at") @db.Timestamptz(6)
  expiresAt            DateTime      @map("expires_at") @db.Timestamptz(6)
  idempotencyKey       String        @unique(map: "agent_action_idempotency_key_key") @map("idempotency_key")
  requestDedupeKey     String        @unique(map: "agent_action_request_dedupe_key_key") @map("request_dedupe_key")
  dedupeExpiresAt      DateTime      @map("dedupe_expires_at") @db.Timestamptz(6)
  result               Json?
  error                Json?
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  executedAt           DateTime?     @map("executed_at") @db.Timestamptz(6)
  executionAttemptCount Int          @default(0) @map("execution_attempt_count")
  resultPartPersistedAt DateTime?    @map("result_part_persisted_at") @db.Timestamptz(6)
  effectReceipt         Json?        @map("effect_receipt")
  effectRecordedAt      DateTime?    @map("effect_recorded_at") @db.Timestamptz(6)
  session              agent_session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                 user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch               branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt], map: "idx_agent_action_session_created")
  @@index([branchId, userId, status], map: "idx_agent_action_owner_status")
  @@index([status, expiresAt], map: "idx_agent_action_status_expires")
  @@index([dedupeExpiresAt], map: "idx_agent_action_dedupe_expires")
}

model agent_trace {
  id                String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId         String           @map("session_id")
  userId            String           @map("user_id") @db.Uuid
  branchId          String           @map("branch_id") @db.Uuid
  model             String
  agentVersion      String           @map("agent_version")
  routedDomains     Json             @default("[]") @map("routed_domains")
  stepMetadata      Json             @default("[]") @map("step_metadata")
  usage             Json?
  latencyMs         Int?             @map("latency_ms")
  outcome           String           @default("running") @db.VarChar(20)
  errorCategory     String?          @map("error_category") @db.VarChar(30)
  redactionMetadata Json?            @map("redaction_metadata")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  finishedAt        DateTime?        @map("finished_at") @db.Timestamptz(6)
  session           agent_session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              user             @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch            branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  messages          agent_message[]
  feedback          agent_feedback[]

  @@index([sessionId, createdAt], map: "idx_agent_trace_session_created")
  @@index([branchId, userId, createdAt], map: "idx_agent_trace_owner_created")
  @@index([outcome, createdAt], map: "idx_agent_trace_outcome_created")
}

model agent_feedback {
  id        String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  sessionId String        @map("session_id")
  messageId String        @map("message_id")
  traceId   String?       @map("trace_id")
  userId    String        @map("user_id") @db.Uuid
  branchId  String        @map("branch_id") @db.Uuid
  type      String        @db.VarChar(20)
  comment   String?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  session   agent_session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  message   agent_message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  trace     agent_trace?  @relation(fields: [traceId], references: [id], onDelete: SetNull)
  user      user          @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch    branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId], map: "agent_feedback_message_user_key")
  @@index([sessionId, createdAt], map: "idx_agent_feedback_session_created")
  @@index([messageId], map: "idx_agent_feedback_message")
  @@index([traceId], map: "idx_agent_feedback_trace")
  @@index([branchId, userId], map: "idx_agent_feedback_owner")
}

model client {
  id                     Int                       @id @default(autoincrement())
  name                   String
  address                String?
  phone                  String?
  suppressGreetingSms    Boolean                   @default(false) @map("suppress_greeting_sms")
  type                   String?
  duration               Int?                      @db.SmallInt
  fullPrice              String?                   @map("full_price")
  grant                  String?
  actualPrice            String?                   @map("actual_price")
  startDate              DateTime?                 @map("start_date") @db.Date
  endDate                DateTime?                 @map("end_date") @db.Date
  careCenter             Boolean?                  @map("care_center")
  voucherClient          Boolean                   @map("voucher_client")
  birthday               String?                   @db.VarChar(6)
  breastPump             Boolean                   @default(false) @map("breast_pump")
  serviceStatus          String?                   @map("service_status")
  eDocId                 String?                   @unique @map("e_doc_id")
  dueDate                DateTime?                 @map("due_date") @db.Date
  birthDate              DateTime?                 @map("birth_date") @db.Date
  createdAt              DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  branchId               String?                   @map("branch_id") @db.Uuid
  areaId                 String?                   @map("area_id")
  eformsignDocByEDocId   eformsign_doc?            @relation("client_e_doc_idToeformsign_doc", fields: [eDocId], references: [documentId], onUpdate: NoAction)
  branch                 branch?                   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  area                   area?                     @relation(fields: [areaId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eformsignDocs          eformsign_doc[]           @relation("eformsign_doc_client_idToclient")
  eformsignDocumentJobs  eformsign_document_job[]
  employeeSchedules      employee_schedule[]
  callRecords            call_record[]
  clientDrafts           client_draft[]
  scheduleChangeRequests schedule_change_request[]
  messageLogs            message_log[]
  messageTriggerJobs     message_trigger_job[]
  serviceRecordCase      service_record_case?

  @@unique([branchId, phone], map: "client_branch_phone_key")
  @@index([areaId], map: "idx_client_area")
  @@index([branchId], map: "idx_client_branch")
  @@index([createdAt], map: "idx_client_created_at")
}

model doc_template {
  areaId       String  @map("area_id")
  templateId   String  @map("template_id")
  templateName String? @map("template_name")
  id           String  @id @default(dbgenerated("(gen_random_uuid())::text"))
  area         area    @relation(fields: [areaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model document {
  id               String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  name             String
  description      String?
  tags             String[]
  mimeType         String            @map("mime_type")
  fileSize         Int               @map("file_size")
  storagePath      String            @map("storage_path")
  storageUrl       String?           @map("storage_url")
  orgId            String?           @map("org_id")
  uploadedBy       String            @map("uploaded_by")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @map("updated_at") @db.Timestamptz(6)
  categoryId       String            @map("category_id")
  branchId         String?           @map("branch_id") @db.Uuid
  documentCategory document_category @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch           branch?           @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([categoryId])
  @@index([orgId])
  @@index([uploadedBy])
  @@index([branchId], map: "idx_document_branch")
}

/// Database note: partial unique index `document_category_value_global_key` on
/// (value) WHERE branch_id IS NULL exists in the database but cannot be expressed
/// in Prisma (created via migration/patch SQL). It keeps global (branch-null) seed
/// category values unique; the composite unique below only covers branch-owned rows
/// because Postgres never treats two NULL branch_id values as equal.
model document_category {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  value     String
  label     String
  color     String
  isCustom  Boolean    @default(true) @map("is_custom")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  branchId  String?    @map("branch_id") @db.Uuid
  documents document[]
  branch    branch?    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([branchId, value], map: "document_category_branch_id_value_key")
  @@index([branchId], map: "idx_document_category_branch")
}

model eformsign_doc {
  id                         Int                            @id @default(autoincrement())
  documentId                 String                         @unique @map("document_id")
  documentName               String?                        @map("document_name")
  documentNumber             String?                        @map("document_number")
  templateName               String?                        @map("template_name")
  customerName               String?                        @map("customer_name")
  customerPhone              String?                        @map("customer_phone") @db.VarChar(11)
  creatorName                String?                        @map("creator_name")
  lastEditorName             String?                        @map("last_editor_name")
  stepRecipientTypes         String?                        @map("step_recipient_types")
  createdDate                DateTime                       @map("created_date") @db.Timestamptz(6)
  updatedDate                DateTime                       @map("updated_date") @db.Timestamptz(6)
  statusType                 String                         @map("status_type")
  statusDetail               String                         @map("status_detail")
  stepType                   String                         @map("step_type")
  stepIndex                  String                         @map("step_index")
  stepName                   String                         @map("step_name")
  stepRecipientType          String                         @map("step_recipient_type")
  stepRecipientName          String                         @map("step_recipient_name")
  stepRecipientSms           String                         @map("step_recipient_sms")
  expiredDate                DateTime                       @map("expired_date") @db.Timestamptz(6)
  expired                    Boolean                        @default(false)
  clientId                   Int?                           @map("client_id")
  autoRegisteredClient       Boolean                        @default(false) @map("auto_registered_client")
  branchId                   String?                        @map("branch_id") @db.Uuid
  documentKind               String?                        @map("document_kind")
  employeeScheduleId         Int?                           @map("employee_schedule_id")
  templateId                 String?                        @map("template_id")
  serviceRecordCaseId        String?                        @map("service_record_case_id") @db.Uuid
  snapshotVersion            Int?                           @map("snapshot_version")
  snapshotChunkIndex         Int?                           @map("snapshot_chunk_index")
  detailPayload              Json?                          @map("detail_payload") @db.JsonB
  detailSourceUpdatedDate    DateTime?                      @map("detail_source_updated_date") @db.Timestamptz(6)
  detailSyncedAt             DateTime?                      @map("detail_synced_at") @db.Timestamptz(6)
  syncStatus                 String                         @default("pending") @map("sync_status")
  syncError                  String?                        @map("sync_error")
  syncErrorAt                DateTime?                      @map("sync_error_at") @db.Timestamptz(6)
  permanentPurgeRequestedAt  DateTime?                      @map("permanent_purge_requested_at") @db.Timestamptz(6)
  autoFinalizeAttempts       Int                            @default(0) @map("auto_finalize_attempts")
  autoFinalizeLastAttemptAt  DateTime?                      @map("auto_finalize_last_attempt_at") @db.Timestamptz(6)
  autoFinalizeLastError      String?                        @map("auto_finalize_last_error")
  clientByEDocId             client?                        @relation("client_e_doc_idToeformsign_doc")
  client                     client?                        @relation("eformsign_doc_client_idToclient", fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  employeeSchedule           employee_schedule?             @relation(fields: [employeeScheduleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  serviceRecordCase          service_record_case?           @relation(fields: [serviceRecordCaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  serviceRecordSnapshotChunk service_record_snapshot_chunk?
  branch                     branch?                        @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  files                      eformsign_doc_file[]

  @@unique([serviceRecordCaseId, snapshotVersion, snapshotChunkIndex], map: "uniq_eformsign_doc_service_record_chunk")
  @@index([branchId], map: "idx_eformsign_doc_branch")
  @@index([branchId, customerPhone], map: "idx_eformsign_doc_branch_customer_phone")
  @@index([documentKind], map: "idx_eformsign_doc_document_kind")
  @@index([employeeScheduleId], map: "idx_eformsign_doc_employee_schedule_id")
  @@index([templateId], map: "idx_eformsign_doc_template_id")
  @@index([serviceRecordCaseId], map: "idx_eformsign_doc_service_record_case_id")
  @@index([permanentPurgeRequestedAt], map: "idx_eformsign_doc_permanent_purge_requested_at")
}

/// Durable provider-operation state. PostgreSQL permits multiple NULL values in
/// a unique index, so activeKey releases terminal jobs while still matching the
/// Prisma unique definition. Value checks are authoritative in the SQL patch.
model eformsign_document_job {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId           String    @map("branch_id") @db.Uuid
  clientId           Int?      @map("client_id")
  documentId         String?   @map("document_id")
  jobType            String    @map("job_type") @db.VarChar(32)
  source             String    @db.VarChar(20)
  status             String    @default("queued") @db.VarChar(24)
  requestKey         String    @map("request_key") @db.VarChar(255)
  activeKey          String?   @map("active_key") @db.VarChar(255)
  payload            Json?     @db.JsonB
  payloadFingerprint String?   @map("payload_fingerprint") @db.Char(64)
  progressStep       String?   @map("progress_step") @db.VarChar(80)
  attempts           Int       @default(0)
  nextAttemptAt      DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  heartbeatAt        DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  leaseToken         String?   @map("lease_token") @db.Uuid
  autoFinalizeOutcomeRecordedAt DateTime? @map("auto_finalize_outcome_recorded_at") @db.Timestamptz(6)
  startedAt          DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  lastErrorCode      String?   @map("last_error_code") @db.VarChar(80)
  createdByUserId    String?   @map("created_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch             branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client             client?   @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdByUser      user?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([requestKey], map: "eformsign_document_job_request_key_key")
  @@unique([activeKey], map: "eformsign_document_job_active_key_key")
  @@index([status, nextAttemptAt, createdAt], map: "idx_eformsign_document_job_status_next_attempt_created")
  @@index([branchId, status, updatedAt], map: "idx_eformsign_document_job_branch_status_updated")
  @@index([documentId], map: "idx_eformsign_document_job_document_id")
  @@index([clientId], map: "idx_eformsign_document_job_client_id")
}

model eformsign_doc_file {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eformsignDocId     Int           @map("eformsign_doc_id")
  fileType           String        @map("file_type")
  content            Bytes         @db.ByteA
  contentType        String        @map("content_type")
  contentDisposition String?       @map("content_disposition")
  byteSize           Int           @map("byte_size")
  sha256             String        @db.Char(64)
  sourceUpdatedDate  DateTime      @map("source_updated_date") @db.Timestamptz(6)
  syncedAt           DateTime      @default(now()) @map("synced_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  eformsignDoc       eformsign_doc @relation(fields: [eformsignDocId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([eformsignDocId, fileType], map: "uniq_eformsign_doc_file_type")
  @@index([eformsignDocId], map: "idx_eformsign_doc_file_document")
}

model employee {
  id                         Int                         @id @default(autoincrement()) @db.SmallInt
  name                       String
  workArea                   String[]                    @map("work_area")
  phone                      String
  grade                      String
  openToNextWork             Boolean                     @default(true) @map("open_to_next_work")
  companyRegisteredDate      DateTime?                   @map("company_registered_date") @db.Date
  birthday                   String?                     @db.VarChar(6)
  deletedAt                  DateTime?                   @map("deleted_at") @db.Timestamptz(6)
  branchId                   String?                     @map("branch_id") @db.Uuid
  branch                     branch?                     @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  primaryEmployeeSchedules   employee_schedule[]         @relation("employee_schedule_primary_employee_idToemployee")
  secondaryEmployeeSchedules employee_schedule[]         @relation("employee_schedule_secondary_employee_idToemployee")
  serviceRecordTokens        service_record_token[]
  serviceRecordAssignments   service_record_assignment[]
  serviceRecordDays          service_record_day[]

  @@unique([branchId, phone], map: "employee_branch_id_phone_key")
  @@index([branchId], map: "idx_employee_branch")
}

model employee_schedule {
  id                      Int                        @id @default(autoincrement())
  primaryEmployeeId       Int                        @map("primary_employee_id") @db.SmallInt
  workAddress             String                     @map("work_address")
  startDate               DateTime                   @map("start_date") @db.Date
  endDate                 DateTime                   @map("end_date") @db.Date
  replaced                Boolean                    @default(false)
  clientId                Int                        @map("client_id")
  secondaryEmployeeId     Int?                       @map("secondary_employee_id") @db.SmallInt
  branchId                String?                    @map("branch_id") @db.Uuid
  client                  client                     @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch                  branch?                    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  primaryEmployee         employee                   @relation("employee_schedule_primary_employee_idToemployee", fields: [primaryEmployeeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
