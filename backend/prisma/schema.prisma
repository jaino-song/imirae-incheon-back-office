/// Per-assignment no-login feedback access for a 제공인력.
/// The SMS link carries the plaintext link token; a phone challenge mints the access token.
model service_record_token {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String               @map("branch_id") @db.Uuid
  scheduleId          Int                  @map("schedule_id")
  employeeId          Int                  @map("employee_id") @db.SmallInt
  serviceRecordCaseId String?              @map("service_record_case_id") @db.Uuid
  linkTokenHash       String               @unique @map("link_token_hash")
  accessTokenHash     String?              @unique @map("access_token_hash")
  expectedPhoneHash   String               @map("expected_phone_hash")
  verifiedAt          DateTime?            @map("verified_at") @db.Timestamptz(6)
  failedAttempts      Int                  @default(0) @map("failed_attempts")
  expiresAt           DateTime             @map("expires_at") @db.Timestamptz(6)
  active              Boolean              @default(true)
  revokedAt           DateTime?            @map("revoked_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  branch              branch               @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule            employee_schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee            employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  serviceRecordCase   service_record_case? @relation(fields: [serviceRecordCaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([scheduleId], map: "idx_service_record_token_schedule")
  @@index([branchId], map: "idx_service_record_token_branch")
  @@index([serviceRecordCaseId], map: "idx_service_record_token_service_record_case_id")
}

/// One-time service header per assignment (top of the 제공기록지).
model service_record {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId            String               @map("branch_id") @db.Uuid
  scheduleId          Int                  @unique @map("schedule_id")
  serviceRecordCaseId String?              @map("service_record_case_id") @db.Uuid
  momName             String?              @map("mom_name")
  momBirth            String?              @map("mom_birth") @db.VarChar(6)
  babyName            String?              @map("baby_name")
  babyBirth           String?              @map("baby_birth") @db.VarChar(6)
  deliveryType        String?              @map("delivery_type")
  babyWeight          String?              @map("baby_weight")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch              branch               @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule            employee_schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  serviceRecordCase   service_record_case? @relation(fields: [serviceRecordCaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([branchId], map: "idx_service_record_branch")
  @@index([serviceRecordCaseId], map: "idx_service_record_service_record_case_id")
}

/// One row per service session (제공 회차). Locked once submitted (edit-block guardrail).
model service_record_day {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String               @map("branch_id") @db.Uuid
  scheduleId           Int?                 @map("schedule_id")
  serviceRecordCaseId  String?              @map("service_record_case_id") @db.Uuid
  caseSessionIndex     Int?                 @map("case_session_index")
  employeeId           Int?                 @map("employee_id") @db.SmallInt
  employeeNameSnapshot String?              @map("employee_name_snapshot")
  formVersion          Int                  @default(1) @map("form_version")
  sessionIndex         Int                  @map("session_index")
  serviceDate          DateTime             @map("service_date") @db.Date
  answers              Json                 @default("{}")
  etcService           String?              @map("etc_service")
  notes                String?
  paymentConfirmed     Boolean              @default(false) @map("payment_confirmed")
  momApproval          String?              @map("mom_approval")
  clientSignature      String?              @map("client_signature")
  clientSignedAt       DateTime?            @map("client_signed_at") @db.Timestamptz(6)
  locked               Boolean              @default(false)
  submittedAt          DateTime?            @map("submitted_at") @db.Timestamptz(6)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch               branch               @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule             employee_schedule?   @relation(fields: [scheduleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  serviceRecordCase    service_record_case? @relation(fields: [serviceRecordCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee             employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([scheduleId, sessionIndex])
  @@unique([serviceRecordCaseId, caseSessionIndex], map: "uniq_service_record_day_case_session")
  @@index([branchId], map: "idx_service_record_day_branch")
  @@index([serviceRecordCaseId], map: "idx_service_record_day_case")
  @@index([employeeId], map: "idx_service_record_day_employee")
}

/// Client-owned service record lifecycle. Assignment changes never replace this aggregate.
model service_record_case {
  id                    String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId              String                          @map("branch_id") @db.Uuid
  clientId              Int?                            @unique @map("client_id")
  status                String                          @default("WAITING_FOR_DETAILS")
  startDate             DateTime?                       @map("start_date") @db.Date
  endDate               DateTime?                       @map("end_date") @db.Date
  requiredSessionCount  Int?                            @map("required_session_count") @db.SmallInt
  formVersion           Int                             @default(1) @map("form_version")
  momName               String?                         @map("mom_name")
  momBirth              String?                         @map("mom_birth") @db.VarChar(6)
  babyName              String?                         @map("baby_name")
  babyBirth             String?                         @map("baby_birth") @db.VarChar(6)
  deliveryType          String?                         @map("delivery_type")
  babyWeight            String?                         @map("baby_weight")
  completedAt           DateTime?                       @map("completed_at") @db.Timestamptz(6)
  finalizationDueAt     DateTime?                       @map("finalization_due_at") @db.Timestamptz(6)
  finalizationStartedAt DateTime?                       @map("finalization_started_at") @db.Timestamptz(6)
  finalizedAt           DateTime?                       @map("finalized_at") @db.Timestamptz(6)
  documentsCompletedAt  DateTime?                       @map("documents_completed_at") @db.Timestamptz(6)
  finalizationAttempts  Int                             @default(0) @map("finalization_attempts")
  nextAttemptAt         DateTime?                       @map("next_attempt_at") @db.Timestamptz(6)
  lastError             String?                         @map("last_error")
  version               Int                             @default(0)
  createdAt             DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch                branch                          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client                client?                         @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignments           service_record_assignment[]
  days                  service_record_day[]
  serviceRecordTokens   service_record_token[]
  legacyHeaders         service_record[]
  snapshotChunks        service_record_snapshot_chunk[]
  eformsignDocs         eformsign_doc[]

  @@index([branchId, status], map: "idx_service_record_case_branch_status")
  @@index([status, finalizationDueAt], map: "idx_service_record_case_finalization_due")
}

/// Assignment history for a client-owned service record.
model service_record_assignment {
  id                    String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId              String                          @map("branch_id") @db.Uuid
  serviceRecordCaseId   String                          @map("service_record_case_id") @db.Uuid
  scheduleId            Int?                            @unique @map("schedule_id")
  employeeId            Int?                            @map("employee_id") @db.SmallInt
  employeeNameSnapshot  String                          @map("employee_name_snapshot")
  employeePhoneSnapshot String?                         @map("employee_phone_snapshot")
  startDate             DateTime                        @map("start_date") @db.Date
  endDate               DateTime                        @map("end_date") @db.Date
  createdAt             DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                        @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch                branch                          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serviceRecordCase     service_record_case             @relation(fields: [serviceRecordCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  schedule              employee_schedule?              @relation(fields: [scheduleId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  employee              employee?                       @relation(fields: [employeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  snapshotChunks        service_record_snapshot_chunk[]

  @@index([branchId], map: "idx_service_record_assignment_branch")
  @@index([serviceRecordCaseId], map: "idx_service_record_assignment_case")
  @@index([employeeId], map: "idx_service_record_assignment_employee")
}

/// Durable per-chunk claim and reconciliation state for eformsign snapshot creation.
model service_record_snapshot_chunk {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String                     @map("branch_id") @db.Uuid
  serviceRecordCaseId  String                     @map("service_record_case_id") @db.Uuid
  assignmentId         String?                    @map("assignment_id") @db.Uuid
  snapshotVersion      Int                        @default(1) @map("snapshot_version")
  chunkIndex           Int                        @map("chunk_index")
  chunkCount           Int                        @map("chunk_count")
  firstSessionIndex    Int                        @map("first_session_index")
  lastSessionIndex     Int                        @map("last_session_index")
  employeeNameSnapshot String                     @map("employee_name_snapshot")
  sourceHash           String                     @map("source_hash")
  status               String                     @default("PENDING")
  attempts             Int                        @default(0)
  nextAttemptAt        DateTime?                  @map("next_attempt_at") @db.Timestamptz(6)
  claimedAt            DateTime?                  @map("claimed_at") @db.Timestamptz(6)
  createAttemptedAt    DateTime?                  @map("create_attempted_at") @db.Timestamptz(6)
  eformsignDocumentId  String?                    @unique @map("document_id")
  lastError            String?                    @map("last_error")
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  branch               branch                     @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serviceRecordCase    service_record_case        @relation(fields: [serviceRecordCaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignment           service_record_assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  eformsignDoc         eformsign_doc?             @relation(fields: [eformsignDocumentId], references: [documentId], onDelete: SetNull, onUpdate: NoAction)

  @@unique([serviceRecordCaseId, snapshotVersion, chunkIndex], map: "uniq_service_record_snapshot_chunk")
  @@index([branchId], map: "idx_service_record_snapshot_chunk_branch")
  @@index([status, nextAttemptAt], map: "idx_service_record_snapshot_chunk_retry")
}

model schedule_change_request {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId     String            @map("branch_id") @db.Uuid
  scheduleId   Int               @map("schedule_id")
  clientId     Int               @map("client_id")
  sessionIndex Int               @map("session_index")
  fromDate     DateTime          @map("from_date") @db.Date
  toDate       DateTime          @map("to_date") @db.Date
  oldEndDate   DateTime          @map("old_end_date") @db.Date
  newEndDate   DateTime          @map("new_end_date") @db.Date
  status       String            @default("pending")
  reason       String?
  decidedBy    String?           @map("decided_by") @db.Uuid
  requestedAt  DateTime          @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt    DateTime?         @map("decided_at") @db.Timestamptz(6)
  branch       branch            @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schedule     employee_schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client       client            @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([scheduleId], map: "idx_schedule_change_request_schedule")
  @@index([clientId], map: "idx_schedule_change_request_client")
  @@index([branchId], map: "idx_schedule_change_request_branch")
}

model call_record {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId             String        @map("branch_id") @db.Uuid
  driveFileId          String        @unique @map("drive_file_id")
  fileName             String        @map("file_name")
  recordedAt           DateTime?     @map("recorded_at") @db.Timestamptz(6)
  transcript           Json
  summary              Json?
  category             String?
  callerName           String?       @map("caller_name")
  callerPhone          String?       @map("caller_phone")
  matchedClientId      Int?          @map("matched_client_id")
  processingStatus     String        @default("RECEIVED") @map("processing_status")
  extractionRetryCount Int           @default(0) @map("extraction_retry_count")
  failureReason        String?       @map("failure_reason")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  branch               branch        @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  matchedClient        client?       @relation(fields: [matchedClientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  draft                client_draft?

  @@index([branchId, createdAt], map: "idx_call_record_branch_created")
  @@index([branchId, category], map: "idx_call_record_branch_category")
  @@index([processingStatus], map: "idx_call_record_processing_status")
}

model client_draft {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  callRecordId        String      @unique @map("call_record_id") @db.Uuid
  branchId            String      @map("branch_id") @db.Uuid
  type                String
  status              String      @default("PENDING")
  clientId            Int?        @map("client_id")
  proposals           Json
  requestSummary      String      @map("request_summary")
  extractionMeta      Json?       @map("extraction_meta")
  reviewedById        String?     @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?   @map("reviewed_at") @db.Timestamptz(6)
  discardReason       String?     @map("discard_reason")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmingStartedAt DateTime?   @map("confirming_started_at") @db.Timestamptz(6)
  callRecord          call_record @relation(fields: [callRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch              branch      @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  client              client?     @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  reviewedBy          user?       @relation(fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([branchId, status], map: "idx_client_draft_branch_status")
  @@index([clientId], map: "idx_client_draft_client")
}
