DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Database route selected at startup: shared uses DATABASE_URL; direct uses DIRECT_URL.
DATABASE_CONNECTION_MODE="shared"
# Tenant-isolation Prisma extension: off | observe (log/report only, never blocks) | enforce (blocks + throws).
TENANT_ISOLATION_MODE="observe"
APP_HOST="0.0.0.0"
APP_PORT="3001"
# Global Nest scheduler registration switch. Keep false while Railway owns
# scheduled work during the Lightsail shadow deployment.
SCHEDULERS_ENABLED="false"
JWT_SECRET="replace-me"
KAKAO_CLIENT_ID="replace-me"
KAKAO_CLIENT_SECRET=""
KAKAO_CALLBACK_URL="http://localhost:3001/auth/kakao/callback"
DEVELOPMENT_FRONTEND_URL="http://localhost:3000"
DEVELOPMENT_MOBILE_FRONTEND_URL="http://localhost:3000"
PRODUCTION_FRONTEND_URL="https://admin.babyjamjam.com"
PRODUCTION_MOBILE_FRONTEND_URL="https://m.admin.babyjamjam.com"
PREVIEW_FRONTEND_URL="https://admin.babyjamjam.com"
PREVIEW_MOBILE_FRONTEND_URL="https://m.admin.babyjamjam.com"
# Base URL for the no-login 제공기록지 SMS link (/service-record/<token>). Defaults to
# https://m.admin.babyjamjam.com in code; set explicitly per environment.
# Deployed (production/preview/dev on Railway): "https://m.admin.babyjamjam.com"
# Local development: "http://localhost:3000" (the locally running mobile app)
MOBILE_SERVICE_RECORD_BASE_URL="http://localhost:3000"
STORAGE_SIGNED_URL_TTL_SECONDS="300"

# Sentry runtime. DSN is safe for runtime configuration; AUTH_TOKEN is a build secret only.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="dev"
SENTRY_RELEASE=""
SENTRY_ORG="covenant-labs"
SENTRY_PROJECT="babyjamjam-admin"
SENTRY_AUTH_TOKEN=""

EFORMSIGN_COMPANY_ID="replace-me"
EFORMSIGN_WEBHOOK_ALLOWED_COMPANY_IDS=""
EFORMSIGN_WEBHOOK_SECRET="replace-me"
# The 6-hourly eformsign mirror sweep needs a cross-instance lock (VALKEY_URL).
# Set this to true only for single-replica deployments so the sweep — and with
# it auto client registration from mirrored documents — is not skipped.
EFORMSIGN_RECONCILE_ALLOW_UNLOCKED="false"
EFORMSIGN_SERVICE_RECORD_TEMPLATE_ID="replace-me"
EFORMSIGN_SERVICE_RECORD_TEMPLATE_ID_10="replace-me"
EFORMSIGN_SERVICE_RECORD_TEMPLATE_ID_15="replace-me"
EFORMSIGN_SERVICE_RECORD_TEMPLATE_ID_20="replace-me"

# Railway Static Outbound IP registered in the Aligo console for this environment.
ALIGO_STATIC_OUTBOUND_IP="replace-me"
# Durable eformsign queue accepts new HTTP jobs independently from worker drain.
EFORMSIGN_DOCUMENT_JOBS_ACCEPTING_ENABLED=false
EFORMSIGN_DOCUMENT_JOBS_WORKER_ENABLED=false
